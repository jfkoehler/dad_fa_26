% =========================================================
% Course header
%
% Usage:
% \courseheader
%   {Title}
%   {LMTH 2080 --- Data and Design with Python}
%   {August 31, 2026}
%   {Eugene Lang College of Liberal Arts}
%
% Optional image:
% assets/dad-mark.png
% =========================================================
\newcommand{\courseheader}[4]{%
  \noindent
  \begin{minipage}[t]{0.74\textwidth}
    \raggedright
    {\small\bfseries\color{LangRed}
      THE NEW SCHOOL \textbullet{} EUGENE LANG COLLEGE OF LIBERAL ARTS
    \par}
    \vspace{6pt}

    {\fontsize{27}{31}\selectfont\bfseries #1\par}

    \vspace{2pt}

    {\large #2\par}

    \vspace{10pt}

    {\small #3\par}

    \vspace{2pt}

    {\small #4\par}
  \end{minipage}%
  \hfill
  \begin{minipage}[t]{0.20\textwidth}
    \raggedleft
    \IfFileExists{assets/dad-mark.png}{%
      \includegraphics[width=\linewidth]{assets/dad-mark.png}%
    }{}
  \end{minipage}

  \par\vspace{8pt}

  {\color{LangRed}\rule{\textwidth}{2.2pt}}

  \vspace{5pt}
}

