  xrightmargin=0pt,
  aboveskip=8pt,
  belowskip=8pt,
  showstringspaces=false,
  columns=fullflexible,
  keepspaces=true,
  breaklines=true,
  tabsize=4,
  keywordstyle=\bfseries,
  commentstyle=\itshape,
  stringstyle=\ttfamily
}

\lstdefinestyle{dadterminal}{
