% Code listings
% =========================================================
\lstdefinestyle{dadcode}{
  backgroundcolor=\color{CodeGray},
  basicstyle=\ttfamily\small,
  frame=single,
  rulecolor=\color{CodeBorder},
  framerule=0.6pt,
  framesep=6pt,
